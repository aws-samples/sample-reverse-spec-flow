# profile.env — Kiro CLI（GP-107 ルール3）
#
# 読むのは `init.sh` と手順書の記入者だけ。**ゲートは読まない**（GP-107 ルール4）。
# 値の根拠はすべて MEASURED.md（kiro-cli 2.33.0 / 2026-10-21 の実測）。未測定の項目は unknown のままにする。
#
# 【IDE の実測を流用しない】Kiro IDE（1.4.5）とは別の版系列＝別製品である（GP-107 ルール2）。
# 実測したのは**検証官の隔離に関わる項目と skill の読み込み**だけで、生成パイプライン全体は回していない。
# 完走・スモークとも未実施なので placed-unverified を名乗る（unknown は「測っていない」の開示。hosts/_template/profile.env）。

# --- 識別 ---
HOST_SURFACE=kiro-cli
MEASURED_VERSION=2.33.0            # V2 エンジン（既定）と V3 エンジン（--v3）の両方を測った
SUPPORT_LEVEL=placed-unverified    # 完走・スモークとも未実施。検証官の隔離は実データの e2e で確認済み（MEASURED.md 項目 4・5）

# --- 配置物（apply-host.sh がホストを切り替えたとき、前のホストの残りとして示す。HOST.md / HOST-SETUP.md は共通部分（hosts/_place-common.sh）が置くので書かない）---
PLACED_PATHS=".kiro/skills spec-extraction/03-audit/kiro-verify.sh"

# --- 入口文書 ---
ENTRY_DOCS=agents-md               # 起動ディレクトリ直下の AGENTS.md と .kiro/steering/ を起動時に注入する（V3）
NESTED_ENTRY_AUTOLOAD=on-open      # V3 は**アクセスしたディレクトリ**の入れ子 AGENTS.md を注入する。読み取りが deny で
                                   # 拒否されても注入される。V2 は読まない（MEASURED.md 項目 1）

# --- skill ---
SKILLS=native
SKILLS_DIR=.kiro/skills            # V3 は .kiro/skills/ だけを読む。V2 は .claude/skills/ も読み、同名なら .kiro/skills/ を使う
                                   # V3 の非対話モードでは skill の読み込み自体が確認待ち＝拒否になる（MEASURED.md 項目 2）

# --- サブエージェント ---
SUBAGENT=yes                       # V2 のツール名は subagent（MEASURED.md 項目 3）
SUBAGENT_PARALLEL=unknown
SUBAGENT_MAX_CONCURRENT=unknown
SUBAGENT_ARTIFACT_LEAK=no          # 生成物は流入しない（会話履歴は渡らない。V2）。ただし V3 では入れ子 AGENTS.md（規範）が
                                   # アクセス時に注入され、拒否しても止まらない（MEASURED.md 項目 1・4。他 harness と同じ付け方）
SUBAGENT_TOOL_RESTRICT=no          # カスタムエージェントの permissions の deny はワークスペースの中にしか効かず、
                                   # 拒否したディレクトリの AGENTS.md も注入される＝隔離の手段にならない。
                                   # 検証官は別セッションの kiro-verify.sh で隔離する（entry.md §5。MEASURED.md 項目 5）

# --- 解析対象（ワークスペース外）へのアクセス ---
SOURCE_IN_WORKSPACE=no             # 生成を行うメインのセッションでは入れない（SB-5 を配置で担保する）。
                                   # **例外: 検証官セッション（kiro-verify.sh）だけは解析対象をワークスペースにする**。
                                   # 何も信頼しない（--trust-tools=）。読めるのは既定の許可で通るワークスペース内の read だけ（追補 V3-1）。
                                   # 解析対象の変更を検出したら結果を捨てる（rc=4）
HOST_SEARCH_SCOPE=none             # V3 に専用の検索ツールは無い（grep / glob / grep_search / file_search のどれも不在。追補 V3-1・3/3）。
                                   # 検索はシェルに落ちる＝対話では承認、非対話では拒否。ワークスペース外の走査はいずれにせよ成果物に残らない
SOURCE_SCAN=shell
SOURCE_READ=approval-required      # 外へのアクセスは確認待ち。--no-interactive では拒否、--trust-all-tools と --trust-tools=read_file では承認（V3。追補 V3-1 #9）

# --- 実行 ---
SHELL_TIMEOUT_DEFAULT=unknown
OUTPUT_LIMIT=unknown
UNATTENDED=unknown                 # メインのセッションの無人実行は測っていない。非対話モードでシェルだけを信頼させる
                                   # --trust-tools の名前は見つからなかった（MEASURED.md 項目 8）

# --- フック ---
HOOKS=none                         # 使っていない
