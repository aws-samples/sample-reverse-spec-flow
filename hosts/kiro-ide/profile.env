# profile.env — Kiro IDE（GP-107 ルール3）
#
# 読むのは `init.sh` と手順書の記入者だけ。**ゲートは読まない**（GP-107 ルール4）。
# 値の根拠はすべて MEASURED.md（Kiro IDE 1.4.5 / 2026-10-21 の実測）。
#
# 【CLI に流用しない】手元の `kiro-cli` は 2.33.0 で IDE の 1.4.5 とは**別の版系列＝別製品**である。
# A-1〜A-5 のすべてが CLI では未測定。CLI を対象にするなら別 harness を立てて測り直す。

# --- 識別 ---
HOST_SURFACE=kiro-ide
MEASURED_VERSION=1.4.26            # 個別の実測（Phase A・B・V）は 1.4.5。完走試験は 1.4.5 で始め、途中から 1.4.26（両方の版で通った）
SUPPORT_LEVEL=verified-full        # 完走試験（Playbook なし・小規模）で一次・二次とも合格（2026-10-26。dev/completion-run-r5-freeze.md）。
                                   # 規模と試していない経路は MEASURED.md の「この完走が言えないこと」

# --- 配置物（apply-host.sh がホストを切り替えたとき、前のホストの残りとして示す。HOST.md / HOST-SETUP.md は共通部分（hosts/_place-common.sh）が置くので書かない）---
PLACED_PATHS=".kiro/agents/spec-verifier.md .kiro/skills spec-extraction/03-audit/kiro-ide-verify-check.sh spec-extraction/03-audit/kiro-ide-allow.sh"

# --- 入口文書 ---
ENTRY_DOCS=agents-md               # AGENTS.md を直接拾う。ベンダ固有の入口ファイルは要らない
NESTED_ENTRY_AUTOLOAD=on-open      # 起動時は読まないが、**いちど触ると常時ルールに昇格して注入され続ける**
                                   # （部分読みでもファイル全体が昇格する）

# --- skill ---
SKILLS=native
SKILLS_DIR=.kiro/skills            # `.claude/skills/` は黙って無視される
                                   # **提示一覧はセッション開始時のスナップショット**＝配置は開く前に済ませる

# --- サブエージェント ---
SUBAGENT=yes
SUBAGENT_PARALLEL=yes              # 実効 3.3 倍
SUBAGENT_MAX_CONCURRENT=5          # ハードコード（設定不可）。超過分は透過キュー
SUBAGENT_ARTIFACT_LEAK=no          # 生成物の流入 0/3。親で昇格した入れ子 AGENTS.md も継承されない
                                   # ただしサブエージェント**自身**が入れ子のファイルを読もうとすると、
                                   # **拒否されても**その AGENTS.md が注入される（Phase B B-2）
SUBAGENT_TOOL_RESTRICT=partial     # `.kiro/agents/` の tools と permissions は効く（ワークスペースの中も外も deny が効く。
                                   # リンクでも抜けられない）。**外への allow は効かず毎回ダイアログ**。
                                   # **deny は昇格を止めない**。カスタムエージェントは**呼ぶたびに承認が要る**（Phase B B-1）
                                   # **検証官は specs/ を読める（3/3）**＝隔離はツール権限で破れる
                                   # → 検証官は spec-verifier（相対パスの deny）で起動し、**セッション記録で事後に確かめる**
                                   #   （kiro-ide-verify-check.sh。entry.md §5）。**V で成立**: PASS 3/3・FAIL 3/3（C2）・FAIL（C1）
                                   #   → 確かめで PASS した結果は subagent-isolated

# --- 解析対象（ワークスペース外）へのアクセス ---
SOURCE_IN_WORKSPACE=no             # 入れない方針（SB-5 を配置で担保する）
HOST_SEARCH_SCOPE=workspace-only   # 範囲外は**エラーでなく 0 件**を返す（entry.md の禁止事項 1）
SOURCE_SCAN=shell
SOURCE_READ=approval-required      # ダイアログからは**セッション単位まで**（This Session / All Workspaces のみ。V-1）
                                   # ワークスペースの承認ファイルに直接書いても効かない（V-1b。外を指す規則は
                                   # 「相対パスでなければならない」として読み飛ばされる）

# --- 実行 ---
SHELL_TIMEOUT_DEFAULT=120          # 秒。`kiroAgent.terminalCommandTimeout` で変更できる
                                   # gates.sh は最長 21.9 秒（`all`）なので既定で足りる
OUTPUT_LIMIT=30000-tail-kept       # 超過しても末尾が残る＝サマリ行は届く
UNATTENDED=conditional             # HOST-SETUP.md §2 の kiro-ide-allow.sh を人が 1 回走らせれば、シェル・読み書き・検証官の起動は止まる回数が大きく減る見込み
                                   # （**未実測**: 完走試験の後に用意した。次の試験で見る。広く許すリスクは同節）。原典の Read File はセッションごとに 1 回出ることがある（V-1）

# --- フック ---
HOOKS=kiro-json-v1                 # 形式は存在するが**使わない**（必須経路は手順書と gates.sh。GP-107 ルール7）
