# profile.env — Claude Code（GP-107 ルール3）
#
# 読むのは `init.sh` と手順書の記入者だけ。**ゲートは読まない**（GP-107 ルール4）。
# 根拠は MEASURED.md。未測定の項目は unknown のままにする（推測を書かない）。

# --- 識別 ---
HOST_SURFACE=claude-code
MEASURED_VERSION=2.1.265/2.1.267   # 2 環境で実測（教訓 38）。版で挙動が違うので両方を書く
                                   # 検証官の隔離（SUBAGENT_TOOL_RESTRICT・HOOKS）だけは 2.1.305 で実測（MEASURED.md 追補）
SUPPORT_LEVEL=verified-full        # 完走試験 R1〜R4 を通した（dev/completion-run-*-freeze.md）

# --- 配置物（apply-host.sh がホストを切り替えたとき、前のホストの残りとして示す。HOST.md / HOST-SETUP.md は共通部分（hosts/_place-common.sh）が置くので書かない）---
PLACED_PATHS="CLAUDE.md .claude/skills .claude/agents/spec-verifier.md .claude/hooks/verifier-guard.sh spec-extraction/03-audit/claude-verify-check.sh"

# --- 入口文書 ---
ENTRY_DOCS=agents-md+vendor-md     # ルート AGENTS.md ＋ CLAUDE.md（@AGENTS.md の 1 行）
NESTED_ENTRY_AUTOLOAD=no           # 起動時の作業ディレクトリにした場合を除き読まれない

# --- skill ---
SKILLS=native
SKILLS_DIR=.claude/skills

# --- サブエージェント ---
SUBAGENT=yes
SUBAGENT_PARALLEL=yes
SUBAGENT_MAX_CONCURRENT=unknown    # 上限を測っていない（R1〜R4 では運用上の待ち行列で律した）
SUBAGENT_ARTIFACT_LEAK=no          # 会話履歴は渡らない（2.1.305 で実測）。ただしルートの CLAUDE.md（と @ で取り込む AGENTS.md）は
                                   # サブエージェントにも注入される。検証官の定義は omitClaudeMd でこれを止める（MEASURED.md 項目 4）。
                                   # omitClaudeMd は 2.1.271 以降（公式ドキュメント）。それより前では黙って無視される（entry.md §5 の版の下限）。
                                   # git status のスナップショット（直近コミット）は omitClaudeMd でも入る（entry.md §5）
SUBAGENT_TOOL_RESTRICT=yes         # 定義の tools と frontmatter の PreToolUse hook で読み取りを SOURCE_PATH の配下に絞れる
                                   # （2.1.305 で実測。hook はワークスペースの信頼を承認するまで動かない。MEASURED.md 項目 5）

# --- 解析対象（ワークスペース外）へのアクセス ---
SOURCE_IN_WORKSPACE=no
HOST_SEARCH_SCOPE=unknown          # 測っていない。R1〜R4 はシェル経由の走査で回した
SOURCE_SCAN=shell
SOURCE_READ=free                   # R1〜R4 で承認に阻まれた記録はない

# --- 実行 ---
SHELL_TIMEOUT_DEFAULT=unknown
OUTPUT_LIMIT=unknown
UNATTENDED=yes                     # 完走試験を通した実績がある

# --- フック ---
HOOKS=agent-frontmatter-pretooluse # 検証官（spec-verifier）の読み取り制限だけに使う。ゲートの合否の根拠にはしない（GP-107 ルール7）。
                                   # 動かなかったときは検証結果を捨てて GP-16 ルール8 の縮退へ倒す（entry.md §5）
