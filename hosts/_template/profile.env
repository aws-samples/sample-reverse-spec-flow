# profile.env — ホストの能力宣言（GP-107 ルール3）
#
# 【読み手】`init.sh`（配置）と、手順書の記入者（work-plan の並列プロファイル等）だけ。
# 【ゲートは読まない】`templates/gates.sh` がこのファイルを読むと、同じ成果物の合否が
#   ホストで変わり、完走試験の比較ができなくなる（GP-107 ルール4）。
#
# 【分からない項目は `unknown` と書く】推測を書かない。能力は内側から検出できないので
#   （無効なことを内側から見分けられない機構が実在する）、**測った結果だけを書く**。
#   `MEASURED.md` が無い harness は `SUPPORT_LEVEL=placed-unverified` より上を名乗れない（GP-107 ルール8）。
#   `unknown` は残ってよい——対応レベルは実測と完走試験で決まり、`unknown` は「その項目は測っていない」の開示である
#   （例: claude-code は同時実行数などが unknown のまま verified-full。完走に要らない項目は測らなくてよい）。

# --- 識別 ---
HOST_SURFACE=                 # 例: claude-code / kiro-ide。ディレクトリ名と一致させる
MEASURED_VERSION=             # 実測したホストの版（例: 1.4.5）。未測定なら unknown
SUPPORT_LEVEL=placed-unverified   # verified-full | verified-smoke | placed-unverified

# --- 配置物（apply-host.sh がホストを切り替えたとき、前のホストの残りとして示す。HOST.md / HOST-SETUP.md は共通部分（hosts/_place-common.sh）が置くので書かない）---
PLACED_PATHS=""             # このホストが仕様リポジトリに置くパス（空白区切り・ルートからの相対）。**置いた単位で書く**（他ホストと共有する親の .kiro などでまとめない。まとめると切り替えのとき残りが示されない）。例: "VENDOR.md .vendor/skills"

# --- 入口文書（規範の読ませ方）---
ENTRY_DOCS=                   # agents-md | agents-md+vendor-md | rules-mdc | unknown
NESTED_ENTRY_AUTOLOAD=unknown # no | on-open（開くと昇格）| yes | unknown

# --- skill ---
SKILLS=unknown                # native（ホストの機構で動く）| degraded（手順書を直接読ませる）| unknown
SKILLS_DIR=                   # native のときの配置先（placement.sh が使う）

# --- サブエージェント（GP-15 / GP-22 の隔離に直結）---
SUBAGENT=unknown              # yes | no | unknown
SUBAGENT_PARALLEL=unknown     # yes | no | unknown
SUBAGENT_MAX_CONCURRENT=unknown  # 数値 | unlimited | unknown。設定可否も MEASURED.md に書く
SUBAGENT_ARTIFACT_LEAK=unknown   # no（生成物が流入しない）| yes | unknown
SUBAGENT_TOOL_RESTRICT=unknown   # yes（ツールを絞れる）| no | unknown

# --- 解析対象（ワークスペース外）へのアクセス ---
SOURCE_IN_WORKSPACE=no        # no を既定とする（SB-5 を配置で担保する）
HOST_SEARCH_SCOPE=unknown     # workspace-only | all | none（専用の検索ツールが無い）| unknown
SOURCE_SCAN=unknown           # shell | host-tools | unknown
SOURCE_READ=unknown           # free | approval-required | unknown

# --- 実行 ---
SHELL_TIMEOUT_DEFAULT=unknown # 秒。unknown なら MEASURED.md に実測を残す
OUTPUT_LIMIT=unknown          # 出力の上限と超過時の扱い（末尾が残るか等）
UNATTENDED=unknown            # yes | conditional（セットアップ次第）| no | unknown

# --- フック（任意。合否の根拠にしない。GP-107 ルール7）---
HOOKS=none                    # none | <形式名>
